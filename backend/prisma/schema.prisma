// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------
enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  PROJECT_MANAGER
  TEAM_LEAD
  DEVELOPER
  QA_TESTER
  CLIENT
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum Visibility {
  PRIVATE
  PUBLIC
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  TESTING
  BLOCKED
  DONE
}

enum BookmarkType {
  PROJECT
  TASK
}

enum TeamStatus {
  ACTIVE
  ARCHIVED
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String
  name            String
  avatarUrl       String?
  bio             String?
  skills          String[]
  experience      String?
  github          String?
  linkedin        String?
  website         String?
  role            Role     @default(VIEWER)
  status          UserStatus @default(ACTIVE)
  isVerified      Boolean  @default(false)
  lastLogin       DateTime?
  
  // Relations
  ownedOrgs       Organization[]       @relation("OrgOwner")
  orgMemberships  OrganizationMember[]
  teamMemberships TeamMember[]
  ledTeams        Team[]               @relation("TeamLead")
  projectMemberships ProjectMember[]
  ownedProjects   Project[]            @relation("ProjectOwner")
  reportedTasks   Task[]               @relation("TaskReporter")
  assignedTasks   TaskAssignee[]
  comments        Comment[]
  attachments     Attachment[]
  notifications   Notification[]
  activityLogs    ActivityLog[]
  timeLogs        TimeLog[]
  bookmarks       Bookmark[]
  sentInvitations Invitation[]
  teamMessages    TeamMessage[]

  wikiPages       WikiPage[]         @relation("WikiAuthor")
  discussions     Discussion[]       @relation("DiscussionAuthor")
  discussionReplies DiscussionReply[]  @relation("DiscussionReplyAuthor")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Organization {
  id              String   @id @default(uuid())
  name            String
  logo            String?
  billingStatus   String   @default("FREE")
  ownerId         String
  owner           User     @relation("OrgOwner", fields: [ownerId], references: [id])
  
  members         OrganizationMember[]
  teams           Team[]
  projects        Project[]
  invitations     Invitation[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OrganizationMember {
  id              String   @id @default(uuid())
  userId          String
  organizationId  String
  role            Role     @default(VIEWER)
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  joinedAt        DateTime @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Team {
  id              String      @id @default(uuid())
  name            String
  description     String?
  avatarUrl       String?
  color           String      @default("#6366f1")
  email           String?
  status          TeamStatus  @default(ACTIVE)
  organizationId  String
  leadId          String?
  
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead            User?        @relation("TeamLead", fields: [leadId], references: [id])
  members         TeamMember[]
  invitations     Invitation[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  projects        Project[]
  messages        TeamMessage[]
  sprints         Sprint[]
  attachments     Attachment[]
}

model TeamMember {
  id              String   @id @default(uuid())
  userId          String
  teamId          String
  role            Role     @default(DEVELOPER)
  designation     String?
  skills          String[]
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  joinedAt        DateTime @default(now())

  @@unique([userId, teamId])
}

model Project {
  id              String   @id @default(uuid())
  name            String
  projectKey      String?
  description     String?
  logo            String?
  banner          String?
  color           String?
  status          ProjectStatus @default(ACTIVE)
  startDate       DateTime?
  deadline        DateTime?
  priority        TaskPriority  @default(MEDIUM)
  estimatedBudget Float?
  tags            String[]
  visibility      Visibility    @default(PRIVATE)
  
  ownerId         String
  organizationId  String
  teamId          String?
  
  owner           User          @relation("ProjectOwner", fields: [ownerId], references: [id])
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team            Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  
  members         ProjectMember[]
  tasks           Task[]
  labels          Label[]
  wikiPages       WikiPage[]
  discussions     Discussion[]
  attachments     Attachment[]
  boardColumns    BoardColumn[]
  swimlanes       Swimlane[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([ownerId])
  @@index([teamId])
}

model ProjectMember {
  id              String   @id @default(uuid())
  userId          String
  projectId       String
  role            Role     @default(VIEWER)
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  joinedAt        DateTime @default(now())

  @@unique([userId, projectId])
}

model Task {
  id              String   @id @default(uuid())
  title           String
  description     String?
  priority        TaskPriority @default(MEDIUM)
  status          TaskStatus   @default(TODO)
  startDate       DateTime?
  dueDate         DateTime?
  estimatedHours  Float?
  actualHours     Float?
  coverImage      String?
  
  projectId       String
  reporterId      String
  sprintId        String?
  columnId        String?
  swimlaneId      String?
  
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter        User     @relation("TaskReporter", fields: [reporterId], references: [id])
  sprint          Sprint?  @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  column          BoardColumn? @relation(fields: [columnId], references: [id], onDelete: SetNull)
  swimlane        Swimlane?    @relation(fields: [swimlaneId], references: [id], onDelete: SetNull)
  
  assignees       TaskAssignee[]
  subtasks        Subtask[]
  checklists      Checklist[]
  comments        Comment[]
  attachments     Attachment[]
  timeLogs        TimeLog[]
  labels          TaskLabel[]
  
  dependencies    TaskDependency[] @relation("TaskSuccessor")
  dependentOn     TaskDependency[] @relation("TaskPredecessor")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([projectId])
  @@index([reporterId])
  @@index([sprintId])
}

model TaskAssignee {
  id              String   @id @default(uuid())
  userId          String
  taskId          String
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  assignedAt      DateTime @default(now())

  @@unique([userId, taskId])
  @@index([userId])
  @@index([taskId])
}

model TaskDependency {
  id              String   @id @default(uuid())
  predecessorId   String
  successorId     String
  type            String   @default("BLOCKS") // e.g. BLOCKS, IS_BLOCKED_BY
  
  predecessor     Task     @relation("TaskPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor       Task     @relation("TaskSuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
}

model Subtask {
  id              String   @id @default(uuid())
  title           String
  isCompleted     Boolean  @default(false)
  taskId          String
  
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Checklist {
  id              String   @id @default(uuid())
  title           String
  taskId          String
  
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items           ChecklistItem[]

  createdAt       DateTime @default(now())
}

model ChecklistItem {
  id              String   @id @default(uuid())
  content         String
  isCompleted     Boolean  @default(false)
  checklistId     String
  
  checklist       Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
}

model Comment {
  id              String   @id @default(uuid())
  content         String
  authorId        String
  taskId          String?
  parentId        String?  // For nested replies
  
  author          User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  task            Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parent          Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies         Comment[] @relation("CommentReplies")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Attachment {
  id        String   @id @default(uuid())
  filename  String
  url       String
  size      Int      // in bytes
  type      String   // mime type
  
  taskId    String?
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  uploaderId String
  uploader   User    @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Notification {
  id              String   @id @default(uuid())
  type            String   // TASK_ASSIGNED, MENTION, etc.
  content         String
  isRead          Boolean  @default(false)
  link            String?
  userId          String
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model ActivityLog {
  id              String   @id @default(uuid())
  action          String
  entityType      String   // TASK, PROJECT, USER, etc.
  entityId        String
  details         String?  // JSON stringified details
  userId          String
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([entityId])
  @@index([createdAt])
}

model Label {
  id              String   @id @default(uuid())
  name            String
  color           String
  projectId       String
  
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks           TaskLabel[]

  createdAt       DateTime @default(now())
}

model TaskLabel {
  id              String   @id @default(uuid())
  taskId          String
  labelId         String
  
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label           Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([taskId, labelId])
}

model TimeLog {
  id              String   @id @default(uuid())
  startTime       DateTime
  endTime         DateTime?
  durationMinutes Int?
  description     String?
  
  userId          String
  taskId          String
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Bookmark {
  id              String   @id @default(uuid())
  type            BookmarkType
  entityId        String
  userId          String
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@unique([userId, type, entityId])
}

model Invitation {
  id              String   @id @default(uuid())
  email           String
  role            Role     @default(VIEWER)
  token           String   @unique
  status          String   @default("PENDING") // PENDING, ACCEPTED, EXPIRED

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  teamId          String?
  team            Team?        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  inviterId       String
  inviter         User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  expiresAt       DateTime
}

model TeamMessage {
  id              String   @id @default(uuid())
  content         String
  teamId          String
  senderId        String
  
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sender          User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([teamId])
  @@index([senderId])
}

model Sprint {
  id              String   @id @default(uuid())
  name            String
  goal            String?
  capacity        Float?
  startDate       DateTime
  endDate         DateTime
  status          String   @default("PLANNED") // PLANNED, ACTIVE, COMPLETED
  teamId          String
  
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tasks           Task[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([teamId])
}

model BoardColumn {
  id        String   @id @default(uuid())
  name      String
  position  Int      @default(0)
  projectId String
  
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Swimlane {
  id        String   @id @default(uuid())
  name      String
  position  Int      @default(0)
  projectId String
  
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model WikiPage {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId    String
  author      User     @relation("WikiAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Discussion {
  id          String   @id @default(uuid())
  title       String
  content     String   @db.Text
  
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId    String
  author      User     @relation("DiscussionAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  replies     DiscussionReply[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DiscussionReply {
  id            String     @id @default(uuid())
  content       String     @db.Text
  
  discussionId  String
  discussion    Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  authorId      String
  author        User       @relation("DiscussionReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}
